# =============================================================================
# Bijou Monorepo — Master .gitignore
# Env vars (NEVER commit secrets) — only .env.example is tracked
# =============================================================================
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging
*.env.flyio
*.env.composio
# Appwrite dev-creds file (added 2026-08-29 — has the live `standard_…` server key)
settings.json

# Raw credential files written by ops scripts (fly/vercel/supabase tokens).
# These are live deploy credentials — never tracked.
*_token
*_token[0-9]
.test_token
ops/.fly_*
ops/.vercel_*
ops/.supabase_*
ops/.bridge_app

# -----------------------------------------------------------------------------
# Credential classes not covered by the rules above. Added 2026-08-24 after a
# full-tree scan (2361 files). The scan found 0 unignored secret files, so this
# block is prophylactic — it closes shapes this repo has not produced yet.
#
# NOTE: none of this untracks anything already committed. `git rm --cached` +
# history rewrite + credential rotation is the only remedy for that.
# -----------------------------------------------------------------------------
# Private keys / certificates / keystores
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519

# Package-manager and shell credential stores
.netrc
_netrc
.npmrc
.pypirc
.pgpass
.dockercfg

# Cloud service-account / credential blobs
*service-account*.json
*serviceaccount*.json
*-credentials.json
credentials.json
gha-creds-*.json
client_secret*.json
secrets.json
secrets.y*ml
.secrets/

# Ad-hoc backups of config files — these routinely carry real values
*.backup.json
*.bak
*~

# Cloud CLI state
.aws/
.gcloud/
.azure/
.fly/
.supabase/

# =============================================================================
# Agent/debug scratch. Underscore prefix = throwaway probe, not product code.
# Keeps `git status` readable so real changes are visible.
# =============================================================================
ops/_*
ops/*.err
packages/backend/app/_*.cjs
packages/backend/logs/_*.cjs   # scratch probes dropped in logs/ by ad-hoc debugging
/.tmp_*.json                 # one-off curl probe bodies (auth flow tests, etc.)

# =============================================================================
# Node / TypeScript / Vite
# =============================================================================
node_modules/
dist/
*.tsbuildinfo
dist.tgz
.npm/
.eslintcache

# =============================================================================
# Python (backend)
# =============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv-*/
.pytest_cache/
.ruff_cache/
*.egg-info/

# =============================================================================
# Go (bridge) — compiled binaries only, not the source tree
# (The bare names "bridge" and "whatsapp-bridge" match packages/bridge/, so
# we anchor with packages/bridge/ prefix to avoid ignoring the source code.)
# =============================================================================
packages/bridge/bridge
packages/bridge/bridge.exe
packages/bridge/whatsapp-bridge
packages/bridge/whatsapp-bridge.exe
*.test
*.out

# =============================================================================
# Runtime state — logs, DB files, scratch dirs
# =============================================================================
*.log
*.err.log
*.db
*.db-shm
*.db-wal
.cost_watch_scratch_*/
outbox/
outbox/*

# =============================================================================
# OS / editor / tooling
# =============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Tooling state dirs (not source)
.playwright-mcp/
.vercel/
.opencode/
.bob/
.cursor/
.cursorignore
.zed/

# =============================================================================
# Coolify cutover — build artifacts + ephemeral state (added 2026-08-30)
# These are docker image tars + PID/UUID scratch files. The tars are also
# stored separately on the Coolify host after `docker load`. Keep them
# OUT of git to avoid 1+ GB commits.
#
# `.envs-backup.json` is the original Bijou prod env captured before the
# cutover (has SUPABASE_SERVICE_KEY, STRIPE_SECRET_KEY, etc.). MUST stay
# out of git — the same data is mirrored into Coolify via
# `migrate-secrets-to-coolify.ps1` and never lives in the repo.
# =============================================================================
ops/coolify/*.tar
ops/coolify/.build-pid
ops/coolify/.bridge-build-pid
ops/coolify/.agentops-build-pid
ops/coolify/.opt-build-pid
ops/coolify/.test-uuid
ops/coolify/.agentops-uuid
ops/coolify/.agentops-svc-uuid
ops/coolify/.bijou-svc-uuid
ops/coolify/.bridge-uuid
ops/coolify/.synthesized.env
ops/coolify/.push-report.py
ops/coolify/.push.py.bak
ops/coolify/.envs-backup.json

# =============================================================================
# Build artifacts per package
# =============================================================================
packages/landing/dist/
packages/landing/.vercel/
packages/landing/.playwright-mcp/
packages/backend/.venv/
packages/backend/.venv-connectors/
packages/backend/__pycache__/
packages/bridge/bridge
packages/bridge/whatsapp-bridge

# =============================================================================
# Legacy (the original 2 repos we moved out of — keep on disk, ignore in git)
# =============================================================================
legacy/

# Leftover corrupted .git dirs from filter-repo history rewrites (file-locked, can't delete safely)
.git.broken/
.git.broken2/


# Local agent state (Mavis, Claude, Codex, Serena)
.agents/
.codex/
.serena/

# Local Claude Code state
.claude/

# Backup / progress files
packages/backend/scripts/_backup/
