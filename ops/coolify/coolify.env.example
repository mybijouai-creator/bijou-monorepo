# Coolify env-var template for Bijou AI
#
# Copy this file into a Coolify "env group" and fill in the real
# values. Do NOT commit the filled-in version. Coolify stores the
# real values in its database (encrypted at rest) and injects them
# into the container at runtime.
#
# Required vars are marked [required]. Optional vars are marked
# [optional] — they have a sensible default in code if not set.

# ─── Supabase (shared) ────────────────────────────────────────────
# [required] Get from Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# ─── Google AI (Gemini 2.5 Flash) ────────────────────────────────
# [required] Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── Stripe (billing) ────────────────────────────────────────────
# [required] Get from https://dashboard.stripe.com/apikeys
# Use the LIVE secret key for production, test key for staging
STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# [required] Webhook secret from the Stripe dashboard after you
# configure the webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (magic-link login + data-request confirmations) ──────
# [optional] Get from https://resend.com/api-keys
RESEND_API_KEY=re_...

# ─── Cal.com (the 15-min demo booking) ───────────────────────────
# [optional] OAuth client credentials
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=

# ─── Nango (integrations tab) ───────────────────────────────────
# [optional] Get from https://app.nango.dev/ -> Environment Settings
# Leave blank to disable the Integrations tab
NANGO_SECRET_KEY=

# ─── Bridge (per-tenant WhatsApp Web auth) ──────────────────────
# [required] Any long random string. The bridge sends this as a
# Bearer token to the backend on every webhook. Backend verifies.
BRIDGE_API_KEY=

# ─── Feature flags ──────────────────────────────────────────────
# Keep ENABLE_COMPOSIO=false — we use Nango now (per 2026-08-23
# decision in CLAUDE.md)
ENABLE_COMPOSIO=false

# ─── Sentry (optional error tracking) ───────────────────────────
# SENTRY_DSN=

# ─── Logging ─────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Per-tenant overrides (only for per-tenant bridge instances) ─
# These are NOT used by the multi-tenant backend.
# WHATSAPP_SESSION_PATH=/data/whatsapp-session
# BIJOU_BACKEND_URL=http://backend:8080
