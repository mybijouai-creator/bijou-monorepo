# Dokploy env-var template for Bijou AI — CORE STACK (backend + bridge)
#
# Copy the *values* (not this file) into the Compose service's
# Environment tab in the Dokploy UI. Do NOT commit a filled-in version
# of this file. Dokploy stores real values server-side and injects them
# into the containers at deploy time.
#
# Required vars are marked [required]. Optional vars have a safe
# default in code if left blank.

# ─── Supabase (shared) ────────────────────────────────────────────
# [required] Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# ─── Google AI (Gemini) ───────────────────────────────────────────
# [required] https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── Canonical public URL ─────────────────────────────────────────
# [required] STAGING value while this runs parallel to Coolify.
# Use the Dokploy-generated preview domain (or a test subdomain) here,
# e.g. https://dokploy-xxxx.your-dokploy-host — NOT app.mybijou.xyz
# until you've confirmed health and are ready to cut over.
PUBLIC_URL=https://<your-staging-domain>

# ─── Stripe (billing) ─────────────────────────────────────────────
# [required] https://dashboard.stripe.com/apikeys
# Use TEST keys for this staging stack. Only use LIVE keys once this
# stack is the one actually serving production traffic.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (magic-link login) ─────────────────────────────────────
# [optional] https://resend.com/api-keys
RESEND_API_KEY=

# ─── Cal.com (demo booking) ────────────────────────────────────────
# [optional]
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=

# ─── Nango (integrations tab) ──────────────────────────────────────
# [optional] https://app.nango.dev -> Environment Settings. Leave blank
# to disable the Integrations tab.
NANGO_SECRET_KEY=

# ─── Bridge (per-tenant WhatsApp Web auth) ─────────────────────────
# [required] Any long random string — shared bearer secret between
# bridge and backend. Generate your own (e.g. `openssl rand -hex 32`);
# do not reuse the production Coolify BRIDGE_API_KEY for this staging
# stack.
BRIDGE_API_KEY=

# ─── Logging / error tracking ──────────────────────────────────────
LOG_LEVEL=INFO
# SENTRY_DSN=
