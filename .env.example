# =============================================================================
# BIJOU AI — MASTER .env.example
# =============================================================================
# This file documents every env var the monorepo uses, grouped by package.
# It is the SINGLE SOURCE OF TRUTH for which env var goes where.
# Real .env files are gitignored. Copy this to .env (or per-package .env) and
# fill in values. DO NOT commit real values.
#
# Namespace target: every new var should be BIJOU_* to avoid collisions
# with other projects in the same shell (Bold Connect, etc.).
# Legacy vars (no prefix) are still read by existing code — see roadmap below.
# =============================================================================


# -----------------------------------------------------------------------------
# packages/landing/  (Vercel — VITE_* vars are public, others are server-only)
# -----------------------------------------------------------------------------
# Client-side (must have VITE_ prefix — exposed to bundle)
VITE_PUBLIC_SITE_URL=https://mybijou.xyz

# Server-side (Vercel serverless api/*.js) — NEVER use VITE_ prefix
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFY=
FOUNDER_EMAIL=
STRIPE_SECRET_KEY=
INTERNAL_API_TOKEN=

# AI gateway (OmniRoute) + direct Gemini fallback
CUSTOM_API_ENDPOINT=
CUSTOM_API_KEY=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# PostHog (analytics — set in Vercel + Supabase webhook)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# Composite.io (Spam check)
COMPOSIO_API_KEY=


# -----------------------------------------------------------------------------
# packages/backend/  (Fly.io — bijou-production)
# -----------------------------------------------------------------------------
# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=                    # Fly.io internal — set via `fly secrets set`

# AI gateway (lead pipeline) — same gateway as landing
CUSTOM_API_ENDPOINT=
CUSTOM_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_ENDPOINT=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=

# Payment (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFY=
FOUNDER_EMAIL=

# Bridge inter-service auth
BRIDGE_SHARED_SECRET=


# -----------------------------------------------------------------------------
# packages/bridge/  (Coolify — per-tenant, was Fly.io pre-cutover)
# -----------------------------------------------------------------------------
# WhatsApp Web session persistence (stored in packages/bridge/store/*.db)
BRIDGE_STORE_PATH=/data/store
BRIDGE_HTTP_PORT=8080

# Backend auth (the URL flips to the Coolify hostname post-cutover; the
# Fly fallback stays in for emergency rollback)
BACKEND_URL=https://app.mybijou.xyz
BACKEND_API_TOKEN=

# WhatsApp Web multi-account (per-tenant)
TENANT_ID=

# -----------------------------------------------------------------------------
# Appwrite (alongside Supabase, added 2026-08-29)
# -----------------------------------------------------------------------------
# Used ONLY for per-tenant file storage (KB docs, image uploads). The
# auth + multi-tenant DB stay on Supabase + GoTrue. Do NOT remove the
# Supabase vars above.
ENABLE_APPWRITE_STORAGE=false
APPWRITE_ENDPOINT=https://appwrite.getbijou.xyz/v1
APPWRITE_PROJECT_ID=6a90f200002b5ce52621
# Server API key (the long `standard_…` one) — has read+write on
# storage. NEVER expose to the browser. The DEV key is for local +
# staging only — must not be set in prod.
APPWRITE_API_KEY=
APPWRITE_DEV_API_KEY=
# Bucket name in Appwrite Storage where tenant files land.
APPWRITE_STORAGE_BUCKET=bijou-kb-files
# Public read on uploaded files (default false; set true only for
# KB assets you want to link from landing pages).
APPWRITE_STORAGE_PUBLIC_READ=false

# -----------------------------------------------------------------------------
# Porkbun (DNS, added 2026-08-29)
# -----------------------------------------------------------------------------
# Used by ops/coolify/porkbun-cutover.ps1 to flip app.mybijou.xyz
# (and bridge.<tenant>.mybijou.xyz) from Fly to Coolify. Get keys at
# https://porkbun.com/account/api.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Default domains the cutover script operates on. Comma-separated for
# multi-domain ops.
PORKBUN_DOMAINS=mybijou.xyz,getbijou.xyz

# -----------------------------------------------------------------------------
# Coolify (deploy target, added 2026-08-29)
# -----------------------------------------------------------------------------
# The access token from mcp_config.json (Coolify MCP). Used by
# ops/coolify/{wire-coolify,migrate-secrets-to-coolify}.ps1. Never
# commit. Read at script start from the .hermes file by default; can
# be overridden here.
COOLIFY_BASE_URL=https://coolify.getbijou.xyz
COOLIFY_ACCESS_TOKEN=
# Name of the env group the wire script creates.
COOLIFY_ENV_GROUP=bijou-prod
# GitHub repo + branch the manual webhook fires on. Push to main
# triggers Coolify auto-build.
COOLIFY_GITHUB_ORG=mybijouai-creator
COOLIFY_GITHUB_REPO=bijou-monorepo
COOLIFY_GITHUB_BRANCH=main
# HMAC-SHA256 secret shared between the GitHub webhook and the
# Coolify app. 32 bytes random. Rotate by re-running wire-coolify.ps1.
COOLIFY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Infisical (single source of truth for secrets, added 2026-08-29)
# -----------------------------------------------------------------------------
# If set, migrate-secrets-to-coolify.ps1 also writes every var to
# Infisical. Use https://app.infisical.com (cloud) or a self-hosted
# Infisical behind INFISICAL_HOST.
INFISICAL_HOST=https://app.infisical.com
INFISICAL_TOKEN=
INFISICAL_WORKSPACE_ID=
INFISICAL_PROJECT_ID=bijou-prod
INFISICAL_ENVIRONMENT=production


# -----------------------------------------------------------------------------
# CI/CD & deploy tooling
# -----------------------------------------------------------------------------
# Vercel
BIJOU_VERCEL_TOKEN=
BIJOU_VERCEL_ORG_ID=
BIJOU_VERCEL_PROJECT_ID=

# Fly.io
BIJOU_FLY_API_TOKEN=
BIJOU_FLY_APP_BACKEND=bijou-production
BIJOU_FLY_APP_BRIDGE=bijou-bridge

# GitHub
BIJOU_GITHUB_TOKEN=
BIJOU_GITHUB_REPO=W3J-Dev/bijou-monorepo

# Monitoring
BIJOU_HEALTHCHECK_URL=https://app.mybijou.xyz/health
BIJOU_BETTERSTACK_TOKEN=          # optional, for prod uptime monitoring


# -----------------------------------------------------------------------------
# Lead-pipeline cron (run on local machine or Contabo VPS)
# -----------------------------------------------------------------------------
# These are read by the .cjs scripts in packages/backend/app/
# They come from packages/backend/.env (copied from this template)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AI_GATEWAY_URL=https://ai-gateway-bufxd.sprites.app/v1
AI_GATEWAY_KEY=


# =============================================================================
# NAMESPACE ROADMAP
# =============================================================================
# Goal: every var in this repo should be BIJOU_* (no collisions with Bold
# Connect, Bijou staging, etc. when running in the same shell).
#
# Existing code reads legacy names (no prefix). Migration plan:
#   Phase 1 (now): legacy names work. This file is the spec.
#   Phase 2 (Q4): Add BIJOU_* aliases, fall back to legacy.
#   Phase 3 (Q1): Cut over to BIJOU_* only, remove legacy.
#
# For NEW scripts (CI, deploy, agent team): use BIJOU_* from day 1.
# For EXISTING code: leave as-is, don't break prod. The agent team's job
# (bijou-devops) is to migrate one package at a time, behind a flag.
