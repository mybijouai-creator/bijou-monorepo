# Dockerfile for packages/voice (Bijou Voice concierge)
# Build context: repo root
#   docker build -f Dockerfile.voice -t bijou-voice:latest .
#
# Coolify: point a "Docker Image" service at this repo, set
#   DOCKERFILE = Dockerfile.voice
#   PORT = 8100
#   All env vars from ops/coolify/coolify.env.example PLUS the voice
#   group (see AGENT.md "Env vars" table).
FROM python:3.12-slim

# System deps for httpx async, lxml for Telnyx webhook XML parsing,
# and curl for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (better layer caching)
COPY packages/voice/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the voice source
COPY packages/voice/src /app/src

# Copy the Bijou backend modules the voice service depends on
# (shared_context client reads the same Supabase schema)
COPY packages/backend/src/core/shared_context_api.py /app/src/_bijou_shared_context.py

# Non-root user (security: least privilege)
RUN useradd --create-home --shell /bin/bash bijou
RUN chown -R bijou:bijou /app
USER bijou

EXPOSE 8100

# Health-check so Coolify / Docker knows the container is alive
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8100/health || exit 1

# Run uvicorn directly. 2 workers is enough for a 1-CPU voice service
# (voice is dominated by wait-for-DTMF latency, not CPU).
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8100} --workers ${WEB_CONCURRENCY:-2}"]
