# Dockerfile for packages/landing (preview only; production is Vercel)
# Build context: repo root
#   docker build -f Dockerfile.landing -t bijou-landing:latest .
#
# This is a self-hosted preview for Coolify staging. The production
# landing lives on Vercel (Vercel is its own first-class deploy target
# for the landing; Coolify is for backend + bridge).
#
# Multi-stage: vite build -> static files served by nginx-alpine.

FROM node:24-alpine AS builder

WORKDIR /app

# Cache npm install separately
COPY packages/landing/package.json packages/landing/package-lock.json* /app/
RUN npm ci

# Build
COPY packages/landing /app
RUN npm run build

# ─── Final: nginx serving the static dist/ ────────────────────────
FROM nginx:1.27-alpine

# Copy the build output
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA fallback for client-side routing (we have a single hash route
# #/admin/outreach-queue; this still works without server-side routing
# because the index.html handles it)
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
  listen 3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  location / {
    try_files \$uri \$uri/ /index.html;
  }
  # Cache static assets aggressively
  location ~* \.(js|css|woff2?|svg|png|jpg|jpeg|gif|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
}
EOF

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
